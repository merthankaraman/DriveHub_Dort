<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voiceFeedbackRoot"
    android:layout_width="@dimen/voice_overlay_width"
    android:layout_height="@dimen/voice_overlay_height"
    android:background="#DD0D1117"
    android:elevation="14dp"
    android:gravity="top|center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/voiceOverlayHeard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="#FFFFFF"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/voiceOverlayAction"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="#F0F6FC"
        android:textSize="24sp"
        android:textStyle="bold" />
</LinearLayout>
