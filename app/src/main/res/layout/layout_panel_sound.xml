<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutSoundPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- BaÅŸlÄ±k + Geri -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSoundBack"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginEnd="16dp"
                        android:backgroundTint="#21262D"
                        android:minWidth="52dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/back"
                        android:textColor="#C9D1D9"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/motor_sound_title"
                        android:textColor="@color/status_value"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@color/surface_variant"
                    android:padding="10dp"
                    android:text="@string/motor_sound_combo_hint"
                    android:textColor="#8B949E"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvMotorState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/motor_state_placeholder"
                    android:textColor="@color/status_value"
                    android:textSize="15sp" />

                <!-- 5 kadran: RPM | Vites | HÄ±z | GÃ¼Ã§ | Pedal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/gauge_rpm"
                            android:textColor="@color/status_value"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvGaugeRpm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="1000"
                            android:textColor="@color/status_value"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/gauge_gear"
                            android:textColor="@color/status_value"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvGaugeGear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="A0"
                            android:textColor="@color/status_value"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/gauge_speed"
                            android:textColor="@color/status_value"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvGaugeSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="0"
                            android:textColor="@color/status_value"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/gauge_power"
                            android:textColor="@color/status_value"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvGaugePower"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="0.0"
                            android:textColor="@color/status_value"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="@string/gauge_pedal"
                            android:textColor="@color/status_value"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvGaugeThrottle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="0%"
                            android:textColor="@color/status_value"
                            android:textSize="26sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- ÃœST: Ses barÄ± (sadece ses seviyesi) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@color/surface_variant"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="@string/sound_volume"
                        android:textColor="@color/status_value"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seekSoundVolume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:minHeight="32dp" />

                </LinearLayout>

                <!-- Motor sesi STREAM_NOTIFICATION kullanÄ±r; araÃ§ bildirim sesi ile kontrol -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvAlarmVolumeHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/notification_volume"
                        android:textColor="#8B949E"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnAlarmSource"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#21262D"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/sound_source_notification"
                        android:textColor="#C9D1D9"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnAlarmVolumeMax"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#21262D"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/btn_max_volume"
                        android:textColor="#C9D1D9"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- SimÃ¼le hÄ±z + gaz (Ses Kapa'nÄ±n Ã¼stÃ¼nde; HÄ±z Testi ile aÃ§Ä±lÄ±r) -->
                <LinearLayout
                    android:id="@+id/layoutSpeedTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@color/surface_variant"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvSpeedTestLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:text="@string/sim_speed_label"
                        android:textColor="@color/status_value"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seekSpeedTest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:max="170"
                        android:minHeight="32dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/sim_throttle_label"
                        android:textColor="@color/status_value"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seekThrottleTest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:minHeight="32dp" />

                </LinearLayout>

                <!-- 2x3 dÃ¼ÄŸmeler (aÅŸaÄŸÄ±da, kare formda) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSoundToggle"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#21262D"
                            android:text="@string/btn_sound_enabled"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnSoundProfile"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#21262D"
                            android:text="@string/vehicle_sound_placeholder"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSpeedTest"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#21262D"
                            android:text="@string/btn_speed_test"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnGearProfile"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginTop="10dp"
                            android:layout_weight="1"
                            android:backgroundTint="#21262D"
                            android:text="@string/gearbox_normal"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- 3. satÄ±r: Devir eÅŸleme | DiÅŸli Ä±slÄ±ÄŸÄ± -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnRevMatch"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#21262D"
                            android:text="@string/rev_match"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnGearWhine"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#21262D"
                            android:text="@string/gear_whine"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnIdleSettings"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="#21262D"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/btn_idle_settings"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnSubwave"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:layout_weight="1"
                            android:backgroundTint="#21262D"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/btn_subwave_on"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
