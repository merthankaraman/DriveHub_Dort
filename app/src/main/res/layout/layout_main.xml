<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Üst bar: sağda ayarlar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/btn_settings"
            android:backgroundTint="#21262D"
            android:textColor="#C9D1D9"
            android:textSize="16sp"/>
    </LinearLayout>

    <!-- Sol: bilgi | Sağ: 2x2 ızgara -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- SOL: Başlık, durum, hız -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.38"
            android:orientation="vertical"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_title"
                    android:textSize="20sp"
                    android:textColor="@color/status_value"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/main_version"
                    android:textSize="14sp"
                    android:textColor="@color/status_value" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/status_value"
                android:layout_marginBottom="0dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/speed_placeholder"
                android:textSize="22sp"
                android:textColor="@color/status_value"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvBinderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/status_value"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

        <!-- SAĞ: 2x2 ızgara - eşit boşluklar, yuvarlatılmış -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 1. satır -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <Button
                    android:id="@+id/btnDriveRegenPanel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="14dp"
                    android:backgroundTint="#1F6FEB"
                    android:text="@string/btn_drive_regen"
                    android:textColor="#FFFFFF"
                    android:textSize="50sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minHeight="80dp"/>

                <Button
                    android:id="@+id/btnSoundPanel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginBottom="14dp"
                    android:backgroundTint="#21262D"
                    android:text="@string/btn_motor_sound_settings"
                    android:textColor="#C9D1D9"
                    android:textSize="50sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minHeight="80dp"/>
            </LinearLayout>

            <!-- 2. satır -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <Button
                    android:id="@+id/btnConsumptionPanel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#21262D"
                    android:text="@string/consumption_screen"
                    android:textColor="#C9D1D9"
                    android:textSize="50sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minHeight="80dp"/>

                <Button
                    android:id="@+id/btnStatusPanel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#21262D"
                    android:text="@string/status_charging"
                    android:textColor="#C9D1D9"
                    android:textSize="50sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:minHeight="80dp"/>
            </LinearLayout>

            <!-- Demo: ESP, cam, vb. -->
            <Button
                android:id="@+id/btnDemo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#388BFD"
                android:text="@string/btn_demo"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
