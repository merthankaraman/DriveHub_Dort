<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutConsumptionPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="20dp"
    android:paddingEnd="40dp"
    android:paddingBottom="20dp"
    android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Sol: Geri + Tüketim -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnConsumptionBack"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="16dp"
                    android:backgroundTint="#21262D"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/back"
                    android:textColor="#C9D1D9"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/consumption"
                    android:textColor="@color/status_value"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Orta: Üç konumlu seçici — Sürüş | Motor çalıştıktan itibaren | Hayat boyu -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_consumption_segmented"
                    android:padding="4dp">

                    <Button
                        android:id="@+id/btnConsumptionModeCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:minWidth="72dp"
                        android:minHeight="0dp"
                        android:text="@string/consumption_mode_trip"
                        android:textSize="13sp"
                        android:backgroundTint="#21262D"
                        android:textColor="#C9D1D9"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"/>

                    <Button
                        android:id="@+id/btnConsumptionModeSinceStart"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:minWidth="72dp"
                        android:minHeight="0dp"
                        android:layout_marginStart="4dp"
                        android:text="@string/consumption_mode_since_start"
                        android:textSize="13sp"
                        android:backgroundTint="#21262D"
                        android:textColor="#C9D1D9"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"/>

                    <Button
                        android:id="@+id/btnConsumptionModeLifetime"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:minWidth="72dp"
                        android:minHeight="0dp"
                        android:layout_marginStart="4dp"
                        android:text="@string/consumption_lifetime"
                        android:textSize="13sp"
                        android:backgroundTint="#21262D"
                        android:textColor="#C9D1D9"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Sağ: Yol sıfırla + Sürüş geçmişi -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnConsumptionResetTrip"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#21262D"
                    android:text="@string/btn_reset_trip"
                    android:textColor="#C9D1D9"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnDrivingHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="#1F6FEB"
                    android:text="@string/driving_history_title"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/surface_variant"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- SatÄ±r 1: HÄ±z | Vites -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:gravity="center_vertical">

                    <!-- HÄ±z -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvConsumptionSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="--"
                            android:textColor="@color/status_value"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/consumption_speed"
                            android:textColor="#8B949E"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <!-- Vites -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/consumption_gear"
                            android:textColor="#8B949E"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/tvConsumptionGear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="--"
                            android:textColor="@color/status_value"
                            android:textSize="36sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- SatÄ±r 2: GÃ¼Ã§ | Enerji -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:gravity="center_vertical">

                    <!-- GÃ¼Ã§ -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvConsumptionPower"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="--"
                            android:textColor="@color/status_value"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/consumption_power"
                            android:textColor="#8B949E"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <!-- Enerji -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/consumption_energy"
                            android:textColor="#8B949E"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/tvConsumptionEnergy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="--"
                            android:textColor="@color/status_value"
                            android:textSize="36sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Satır 3: Ort. tüketim | Yol (bu oturum) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:gravity="center_vertical">

                    <!-- Ortalama tüketim -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvConsumptionAvgKwhPer100km"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="--"
                            android:textColor="@color/status_value"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/consumption_avg"
                            android:textColor="#8B949E"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <!-- Yol (bu oturum) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/consumption_trip"
                            android:textColor="#8B949E"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/tvConsumptionTripKm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="--"
                            android:textColor="@color/status_value"
                            android:textSize="36sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
