<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="20dp"
    android:paddingEnd="32dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVoiceBack"
            style="@style/Widget.DriveHub.Button.PanelBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/voice_assistant_title"
            android:textColor="@color/status_value"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoiceCommandsHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:minHeight="40dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/voice_btn_commands_help"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvVoiceModelStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="#8B949E"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/voice_assistant_hint"
        android:textColor="#6E7681"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnVoiceListen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:minHeight="52dp"
        android:text="@string/voice_listen_start" />

    <TextView
        android:id="@+id/tvVoiceLive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="#21262D"
        android:text="@string/voice_live_idle"
        android:textColor="#79C0FF"
        android:textSize="17sp" />

    <ScrollView
        android:id="@+id/scrollVoiceLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvVoiceLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#161B22"
            android:padding="12dp"
            android:textColor="#E6EDF3"
            android:textIsSelectable="true"
            android:textSize="15sp"
            android:typeface="monospace" />
    </ScrollView>
</LinearLayout>
