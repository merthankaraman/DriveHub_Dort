<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutSettingsPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="24dp"
    android:paddingEnd="40dp"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <!-- Başlık + Geri -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSettingsBack"
            style="@style/Widget.DriveHub.Button.PanelBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textColor="@color/status_value"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tema -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_section_theme"
        android:textColor="@color/status_value"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">
        <Button
            android:id="@+id/btnThemeDay"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/theme_day"
            android:textSize="13sp"/>
        <Button
            android:id="@+id/btnThemeNight"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/theme_night"
            android:textSize="13sp"/>
        <Button
            android:id="@+id/btnThemeAuto"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/theme_auto"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Dil -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_section_language"
        android:textColor="@color/status_value"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">
        <Button
            android:id="@+id/btnLangTr"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#21262D"
            android:text="@string/lang_tr"
            android:textColor="#C9D1D9"
            android:textSize="13sp"/>
        <Button
            android:id="@+id/btnLangEn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="#21262D"
            android:text="@string/lang_en"
            android:textColor="#C9D1D9"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Motor gücü -->
    <Button
        android:id="@+id/btnMotorPower"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#30363D"
        android:text="@string/motor_power_default"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <!-- Düğme kısayolları -->
    <Button
        android:id="@+id/btnShortcuts"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#1F6FEB"
        android:text="@string/btn_shortcuts"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <!-- Loglar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/logs_detail"
            android:textSize="14sp"
            android:textColor="@color/status_value" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchLogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/status_value" />
    </LinearLayout>

    <!-- Tam ekran modu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/fullscreen_mode_label"
            android:textSize="14sp"
            android:textColor="@color/status_value" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
