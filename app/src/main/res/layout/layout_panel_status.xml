                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Grafik yerine tam ekran grafik iÃ§in buton -->
        <Button
            android:id="@+id/btnOpenChargingGraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/charging_graph_open" />

    </LinearLayout>
