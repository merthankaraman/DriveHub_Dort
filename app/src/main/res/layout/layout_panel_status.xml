<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutStatusPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="20dp"
    android:paddingEnd="40dp"
    android:paddingBottom="20dp"
    android:visibility="gone">

    <!-- Tek satır: geri, şarj geçmişi, grafik | boşluk | SOC, durum, süre -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_charging_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/btnStatusBack"
            style="@style/Widget.DriveHub.Button.PanelBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/back" />

        <Button
            android:id="@+id/btnShowChargingHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_charging_header_button"
            android:minHeight="46dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/btn_charging_history"
            android:textAllCaps="false"
            android:textColor="@color/charging_header_btn_text"
            android:textSize="13sp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnOpenChargingGraph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_charging_header_button"
            android:minHeight="46dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/charging_graph_open"
            android:textAllCaps="false"
            android:textColor="@color/charging_header_btn_text"
            android:textSize="13sp"
            app:backgroundTint="@null" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvChargingHeaderSoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:fontFamily="monospace"
            android:text="--"
            android:textColor="@color/status_value"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChargingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/not_charging"
            android:textColor="@color/status_value"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChargingDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/charging_duration_placeholder"
            android:textColor="@color/charging_energy"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- İki sütun: kalan dikey alanın tamamını kullan; satırlar weight ile eşit bölünür -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Sol sütun: AC / istasyon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_charging_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvLeftColumnTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.12"
                android:text="@string/expected_charge_power"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- V -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_v"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvAcVolt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="--"
                    android:textColor="@color/status_value"
                    android:textSize="44sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- A -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_a"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvAcAmp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="--"
                    android:textColor="@color/status_value"
                    android:textSize="44sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- kW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_kw_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvAcKw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="--"
                    android:textColor="@color/charging_kw"
                    android:textSize="44sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- kWh (toplam enerji) — şarj yokken satırın tamamı gizlenir -->
            <LinearLayout
                android:id="@+id/rowAcEnergy"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_kwh_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvAcEnergy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="--"
                    android:textColor="@color/charging_energy"
                    android:textSize="44sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Sağ sütun: batarya / DC -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_charging_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.12"
                android:text="@string/batarya"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- V -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_v"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvDcVolt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="--"
                    android:textColor="@color/status_value"
                    android:textSize="44sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- gerçek A -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_a"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvDcAmpAct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="--"
                    android:textColor="@color/status_value"
                    android:textSize="44sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- gerçek kW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_kw_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDcKwAct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="--"
                        android:textColor="@color/charging_kw"
                        android:textSize="44sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDcKwChargeHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

            <!-- kWh (toplam enerji) — şarj yokken satırın tamamı gizlenir -->
            <LinearLayout
                android:id="@+id/rowDcEnergy"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_kwh_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDcEnergy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="--"
                        android:textColor="@color/charging_energy"
                        android:textSize="44sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDcEnergyKmHint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
