<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutStatusPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="20dp"
        android:paddingEnd="40dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <!-- BaÅŸlÄ±k + Geri + Yenile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">

            <Button
                android:id="@+id/btnStatusBack"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="#21262D"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/back"
                android:textColor="#C9D1D9"
                android:textSize="18sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:text="@string/charging_status_title"
                android:textColor="@color/status_value"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChargingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/charging_status_label"
                android:textColor="@color/status_value"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvChargingDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/charging_duration_placeholder"
                android:textColor="#7EE787"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Åarj uyuma engelle (toggle) + Åarj geÃ§miÅŸi butonu aynÄ± hizada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchChargingWakeLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text=""
                android:textColor="@color/status_value"
                android:visibility="gone" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/charging_wake_lock"
                android:textColor="@color/status_value"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnShowChargingHistory"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#21262D"
                android:text="@string/btn_charging_history"
                android:textColor="#C9D1D9"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Beklenen Åarj GÃ¼cÃ¼ -->
        <TextView
            android:id="@+id/tvExpectedPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="monospace"
            android:text="@string/expected_charge_power"
            android:textColor="#FFA657"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Ä°ki sÃ¼tun: AC | Batarya (%40 kÄ±saltÄ±ldÄ±, grafik alanÄ± bÃ¼yÃ¼tÃ¼ldÃ¼) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6"
            android:orientation="horizontal">

            <!-- Sol sÃ¼tun: AC -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@color/surface_variant"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:letterSpacing="0.12"
                    android:text="@string/unit_ac"
                    android:textColor="#6E7681"
                    android:textSize="13sp" />

                <!-- V -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_v"
                        android:textColor="#8B949E"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvAcVolt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="--"
