                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- SaÄŸ sÃ¼tun: Batarya -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/surface_variant"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:letterSpacing="0.12"
                    android:text="@string/batarya"
                    android:textColor="#6E7681"
                    android:textSize="13sp" />

                <!-- V -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_v"
                        android:textColor="#8B949E"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDcVolt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="--"
                        android:textColor="@color/status_value"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- gerÃ§ek A -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_a"
                        android:textColor="#8B949E"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDcAmpAct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="--"
                        android:textColor="@color/status_value"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- gerÃ§ek kW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_kw_label"
                        android:textColor="#8B949E"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDcKwAct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="--"
                        android:textColor="#FFA657"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- kWh (toplam enerji) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="@string/unit_kwh_label"
                        android:textColor="#8B949E"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDcEnergy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
