<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="24dp"
            android:paddingEnd="40dp"
            android:paddingBottom="24dp">

    <!-- Başlık + Geri -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDemoBack"
            style="@style/Widget.DriveHub.Button.PanelBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/demo_screen_title"
            android:textColor="@color/status_value"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoiceAssistant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minHeight="44dp"
            android:text="@string/btn_voice_assistant" />
    </LinearLayout>

    <!-- Pencere -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:text="@string/window_section_title"
        android:textColor="@color/status_value"
        android:textSize="18sp"/>
    <Spinner
        android:id="@+id/spinnerWindowSelect"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:minHeight="44dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:backgroundTint="#21262D"/>
    <TextView
        android:id="@+id/tvWindowLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/window_cmd_none"
        android:textColor="@color/status_value"
        android:textSize="16sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnWindowStepClose"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/window_cmd_step_close"/>
        <Button
            android:id="@+id/btnWindowStepOpen"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/window_cmd_step_open"/>
        <Button
            android:id="@+id/btnWindowFullClose"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/window_cmd_full_close"/>
        <Button
            android:id="@+id/btnWindowFullOpen"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/window_cmd_full_open"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvWindowTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/window_target_label"
        android:textColor="@color/status_value"
        android:textSize="16sp"/>
    <SeekBar
        android:id="@+id/seekBarWindowTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"/>
    <Button
        android:id="@+id/btnWindowGoToTarget"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="@string/window_target_go"/>
    <TextView
        android:id="@+id/tvWindowPercentages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/status_value"
        android:textSize="15sp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/window_command_hint"
        android:textColor="@color/status_value"
        android:textSize="14sp"/>

    <!-- Kapı kilidi -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:text="@string/door_lock_title"
        android:textColor="@color/status_value"
        android:textSize="18sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnDoorLock"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/door_lock_btn_lock"/>
        <Button
            android:id="@+id/btnDoorUnlock"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/door_lock_btn_unlock"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvDoorLockStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/status_value"
        android:textSize="15sp"/>

    <!-- Bluetooth kilidi (deneysel) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal"
        android:text="@string/bt_lock_section_title"
        android:textColor="@color/status_value"
        android:textSize="18sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnBtLockSelectDevice"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#21262D"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/bt_lock_select_device"
            android:textColor="@color/status_value"
            android:textSize="15sp"/>
        <TextView
            android:id="@+id/tvBtLockStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bt_lock_status_no_device"
            android:textColor="@color/status_value"
            android:textSize="15sp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bt_lock_enabled_label"
            android:textColor="@color/status_value"
            android:textSize="15sp"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchBtLockEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Hava kalitesi -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:text="@string/air_quality_section_title"
        android:textColor="@color/status_value"
        android:textSize="18sp"/>
    <TextView
        android:id="@+id/tvAirQualityPm25"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/status_value"
        android:textSize="16sp"/>
    <TextView
        android:id="@+id/tvAirQualityOutdoorTemp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/status_value"
        android:textSize="16sp"/>
    <TextView
        android:id="@+id/tvAirQualityPm25Filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/status_value"
        android:textSize="16sp"/>
    <TextView
        android:id="@+id/tvAirQualityAqs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/status_value"
        android:textSize="16sp"/>

    <!-- CPM prop: başlangıç ID + okunacak adet (readTrackSensorFloat / readTrackSensorInt) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:text="@string/demo_cpm_prop_scan_title"
        android:textColor="@color/status_value"
        android:textSize="18sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/etCpmPropStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/demo_cpm_prop_start_hint"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:textColor="@color/status_value"
            android:textColorHint="@color/status_value"
            android:textSize="36sp"
            android:fontFamily="monospace"/>
        <EditText
            android:id="@+id/etCpmPropCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:hint="@string/demo_cpm_prop_count_hint"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:textColor="@color/status_value"
            android:textColorHint="@color/status_value"
            android:textSize="36sp"
            android:fontFamily="monospace"/>
    </LinearLayout>
    <Button
        android:id="@+id/btnCpmPropScan"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:text="@string/demo_cpm_prop_scan_run"/>

    <!-- Klima: setDrvTemp -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:text="HVAC değer gönder"
        android:textColor="@color/status_value"
        android:textSize="18sp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/etDrvTempValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAutofill="no"
            android:inputType="numberSigned"
            android:textColor="@color/status_value"
            android:textColorHint="@color/status_value"
            android:textSize="36sp"
            android:fontFamily="monospace"/>
        <Button
            android:id="@+id/btnDrvTempSend"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="Gönder"/>
    </LinearLayout>

    <!-- Track Mode / OEM sensör ID’leri (MG4Hardware TRACK_SENSOR_*) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:text="@string/demo_track_sensors_title"
        android:textColor="@color/status_value"
        android:textSize="18sp"/>

    <LinearLayout
        android:id="@+id/layoutCpmScanColumns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCpmScanLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/status_value"
            android:textSize="23sp"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/tvCpmScanRight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/status_value"
            android:textSize="23sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
