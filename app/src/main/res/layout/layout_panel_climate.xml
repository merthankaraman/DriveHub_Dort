<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutClimatePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="24dp"
        android:paddingEnd="40dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

        <!-- BaÅŸlÄ±k + Geri butonu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClimateBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="20dp"
                android:backgroundTint="#21262D"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/back"
                android:textColor="#C9D1D9"
                android:textSize="18sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="@string/climate_panel_title"
                android:textColor="@color/status_value"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Overlay (Ã¼stte Ä±sÄ±tma kÄ±sayolu) aÃ§/kapa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/climate_overlay_hint"
                android:textColor="@color/status_value"
                android:textSize="12sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/status_value" />

        </LinearLayout>

        <!-- DÄ°REKSÄ°YON ISITMA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1"
            android:text="@string/heating_steering"
            android:textColor="@color/status_value"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSteerOff"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#21262D"
                android:text="@string/regen_off"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSteerL1"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:backgroundTint="#21262D"
                android:text="@string/level_on"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- SOL KOLTUK ISITMA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1"
            android:text="@string/heating_seat_left"
            android:textColor="@color/status_value"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSeatLOff"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#21262D"
                android:text="@string/regen_off"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSeatLL1"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#21262D"
                android:text="@string/level_sev_1"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSeatLL2"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#21262D"
                android:text="@string/level_sev_2"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSeatLL3"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:backgroundTint="#21262D"
                android:text="@string/level_sev_3"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- SAÄ KOLTUK ISITMA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1"
            android:text="@string/heating_seat_right"
            android:textColor="@color/status_value"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSeatROff"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#21262D"
                android:text="@string/regen_off"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSeatRL1"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#21262D"
                android:text="@string/level_sev_1"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSeatRL2"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#21262D"
                android:text="@string/level_sev_2"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSeatRL3"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:backgroundTint="#21262D"
                android:text="@string/level_sev_3"
                android:textColor="#8B949E"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
