<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/surface">

    <!-- Üst Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="26sp"
                android:textColor="@color/status_value"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v10.0"
                android:textSize="20sp"
                android:textColor="@color/status_value"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_alignParentEnd="true"
            android:text="⚙️"
            android:textSize="50sp"
            app:cornerRadius="32dp"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/status_value"
            android:padding="0dp"/>
    </RelativeLayout>

    <!-- Ana İçerik -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- SOL BİLGİ PANELİ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="50dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="170sp"
                    android:textColor="#FFA657"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed-light"
                    android:includeFontPadding="false"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenGaugeApp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:text="@string/btn_open_gauge_app"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp"
                    android:backgroundTint="@color/panel_button_bg"
                    android:textColor="@color/status_value"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SAĞ KONTROL PANELİ -->
        <GridLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:columnCount="2"
            android:rowCount="2">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="50dp"
                app:cardBackgroundColor="#1F6FEB"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:id="@+id/btnDriveRegenPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="110sp"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_drive_regen"
                        android:textColor="#FFFFFF"
                        android:textSize="34sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="50dp"
                app:cardBackgroundColor="@color/surface_variant"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:id="@+id/btnSoundPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔊"
                        android:textSize="110sp"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_motor_sound_settings"
                        android:textColor="@color/status_value"
                        android:textSize="34sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="50dp"
                app:cardBackgroundColor="@color/surface_variant"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:id="@+id/btnConsumptionPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📈"
                        android:textSize="110sp"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/consumption_screen"
                        android:textColor="@color/status_value"
                        android:textSize="34sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="50dp"
                app:cardBackgroundColor="@color/surface_variant"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:id="@+id/btnStatusPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔋"
                        android:textSize="110sp"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_charging"
                        android:textColor="@color/status_value"
                        android:textSize="34sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>
    </LinearLayout>

    <!-- Demo Buton (En Alt) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDemo"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:text="@string/btn_demo"
        android:textSize="22sp"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        android:backgroundTint="#388BFD"
        android:textColor="#FFFFFF"
        android:visibility="gone"/>

</LinearLayout>
