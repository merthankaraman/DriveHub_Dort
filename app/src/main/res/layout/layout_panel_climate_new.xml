<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutClimatePanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone">

    <!-- Başlık + Geri butonu -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClimateBack"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:backgroundTint="@color/surface_variant"
            android:padding="0dp"
            android:text="←"
            android:textColor="@color/status_value"
            android:textSize="40sp"
            app:cornerRadius="32dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/climate_panel_title"
                android:textColor="@color/status_value"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- DİREKSİYON ISITMA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/heating_steering"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSteerOff"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_variant"
                    android:text="@string/regen_off"
                    android:textColor="@color/status_value"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    app:cornerRadius="32dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSteerL1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_variant"
                    android:text="@string/level_on"
                    android:textColor="@color/status_value"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    app:cornerRadius="32dp" />
            </LinearLayout>

            <!-- SOL KOLTUK ISITMA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/heating_seat_left"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeatLOff"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_variant"
                    android:padding="0dp"
                    android:text="@string/regen_off"
                    android:textColor="@color/status_value"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeatLL1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_variant"
                    android:padding="0dp"
                    android:text="@string/level_sev_1"
                    android:textColor="@color/status_value"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeatLL2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_variant"
                    android:padding="0dp"
                    android:text="@string/level_sev_2"
                    android:textColor="@color/status_value"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeatLL3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_variant"
                    android:padding="0dp"
                    android:text="@string/level_sev_3"
                    android:textColor="@color/status_value"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />
            </LinearLayout>

            <!-- SAĞ KOLTUK ISITMA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/heating_seat_right"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeatROff"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_variant"
                    android:padding="0dp"
                    android:text="@string/regen_off"
                    android:textColor="@color/status_value"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeatRL1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_variant"
                    android:padding="0dp"
                    android:text="@string/level_sev_1"
                    android:textColor="@color/status_value"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeatRL2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_variant"
                    android:padding="0dp"
                    android:text="@string/level_sev_2"
                    android:textColor="@color/status_value"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeatRL3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_variant"
                    android:padding="0dp"
                    android:text="@string/level_sev_3"
                    android:textColor="@color/status_value"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
