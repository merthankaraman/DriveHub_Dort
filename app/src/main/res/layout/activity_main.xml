<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <include
        android:id="@+id/layoutMain"
        layout="@layout/layout_main" />

    <include
        android:id="@+id/layoutSettingsPanel"
        layout="@layout/layout_panel_settings" />

    <include
        android:id="@+id/layoutDriveRegenPanel"
        layout="@layout/layout_panel_drive_regen" />

    <include
        android:id="@+id/layoutRegenPanel"
        layout="@layout/layout_panel_regen" />

    <include
        android:id="@+id/layoutShortcutsPanel"
        layout="@layout/layout_panel_shortcuts" />

    <include
        android:id="@+id/layoutClimatePanel"
        layout="@layout/layout_panel_climate" />

    <include
        android:id="@+id/layoutSoundPanel"
        layout="@layout/layout_panel_sound" />

    <include
        android:id="@+id/layoutIdlePanel"
        layout="@layout/layout_panel_idle" />

    <include
        android:id="@+id/layoutStatusPanel"
        layout="@layout/layout_panel_status" />

    <include
        android:id="@+id/layoutChargingGraphPanel"
        layout="@layout/layout_panel_charging_graph" />

    <include
        android:id="@+id/layoutConsumptionPanel"
        layout="@layout/layout_panel_consumption" />

</FrameLayout>
