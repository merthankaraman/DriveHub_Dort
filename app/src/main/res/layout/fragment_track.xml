<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/track_background_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/trackLeftRail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/track_rail_surface"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G-METER"
                android:textColor="@color/track_label"
                android:textSize="16sp"
                android:tag="track_lbl" />

            <com.drivehub.kadran.AccelGMeterView
                android:id="@+id/gMeter"
                android:layout_width="400dp"
                android:layout_height="400dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvAccelG"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="5"
                android:tag="track_val"
                android:text="--"
                android:textColor="@color/track_value"
                android:textSize="40sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/trackCenterSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/track_center_sheet"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <!-- Geniş ekranda grid yatayda da toplanır -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:maxWidth="680dp"
                android:orientation="vertical">

            <!-- Satır 1: 0–60 | güç % | 0–100 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0–60"
                        android:textColor="@color/track_label"
                        android:textSize="23sp"
                        android:tag="track_lbl" />

                    <TextView
                        android:id="@+id/tvTime_0_60"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="@color/track_value"
                        android:textSize="36sp"
                        android:tag="track_val"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvVehiclePowerPerc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/track_value"
                        android:textSize="58sp"
                        android:tag="track_val"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0–100"
                        android:textColor="@color/track_label"
                        android:textSize="23sp"
                        android:tag="track_lbl" />

                    <TextView
                        android:id="@+id/tvTime_0_100"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="@color/track_value"
                        android:textSize="36sp"
                        android:tag="track_val"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Satır 2: 60–120 | hız | 80–160 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60–120"
                        android:textColor="@color/track_label"
                        android:textSize="23sp"
                        android:tag="track_lbl" />

                    <TextView
                        android:id="@+id/tvTime_60_120"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="@color/track_value"
                        android:textSize="36sp"
                        android:tag="track_val"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvLiveSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/track_speed_big"
                        android:textSize="58sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="80–160"
                        android:textColor="@color/track_label"
                        android:textSize="23sp"
                        android:tag="track_lbl" />

                    <TextView
                        android:id="@+id/tvTime_80_160"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="@color/track_value"
                        android:textSize="36sp"
                        android:tag="track_val"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Satır 3: 0–400 | kW | 0–800 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0–400 m"
                        android:textColor="@color/track_label"
                        android:textSize="23sp"
                        android:tag="track_lbl" />

                    <TextView
                        android:id="@+id/tvTime_0_400"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="@color/track_value"
                        android:textSize="36sp"
                        android:tag="track_val"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvTrackKw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/track_value"
                        android:textSize="58sp"
                        android:tag="track_val"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0–800 m"
                        android:textColor="@color/track_label"
                        android:textSize="23sp"
                        android:tag="track_lbl" />

                    <TextView
                        android:id="@+id/tvTime_0_800"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="@color/track_value"
                        android:textSize="36sp"
                        android:tag="track_val"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Satır 4: 50–0 | fren basıncı | 100–0 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50–0"
                        android:textColor="@color/track_label"
                        android:textSize="23sp"
                        android:tag="track_lbl" />

                    <TextView
                        android:id="@+id/tvTime_50_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="@color/track_value"
                        android:textSize="36sp"
                        android:tag="track_val"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tvTrackBrakePressure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/track_value"
                        android:textSize="58sp"
                        android:tag="track_val"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100–0"
                        android:textColor="@color/track_label"
                        android:textSize="23sp"
                        android:tag="track_lbl" />

                    <TextView
                        android:id="@+id/tvTime_100_0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="—"
                        android:textColor="@color/track_value"
                        android:textSize="36sp"
                        android:tag="track_val"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
            </FrameLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/trackRightRail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/track_rail_surface"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/tireInnerCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tire_panel"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivTireWheelHeader"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@null"
                        android:focusable="true"
                        android:padding="2dp"
                        android:src="@drawable/ic_wheel_header" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvTirePressureUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="bar"
                            android:textColor="@color/track_label"
                            android:textSize="12sp"
                            android:tag="track_lbl"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="°C"
                            android:textColor="@color/track_label"
                            android:textSize="11sp"
                            android:tag="track_lbl" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="204dp"
                    android:layout_height="204dp"
                    android:layout_marginTop="8dp">

                    <View
                        android:id="@+id/tireGridCross"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/tire_grid_cross" />


                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:columnCount="2"
                        android:rowCount="2"
                        android:useDefaultMargins="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/tvTireFlBar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/track_value"
                                android:textSize="18sp"
                                android:tag="track_val"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTireFlTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="@color/track_value"
                                android:textSize="14sp"
                                android:tag="track_val"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/tvTireFrBar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/track_value"
                                android:textSize="18sp"
                                android:tag="track_val"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTireFrTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="@color/track_value"
                                android:textSize="14sp"
                                android:tag="track_val"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/tvTireRlBar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/track_value"
                                android:textSize="18sp"
                                android:tag="track_val"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTireRlTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="@color/track_value"
                                android:textSize="14sp"
                                android:tag="track_val"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_rowWeight="1"
                            android:layout_columnWeight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <TextView
                                android:id="@+id/tvTireRrBar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/track_value"
                                android:textSize="18sp"
                                android:tag="track_val"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTireRrTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="--"
                                android:textColor="@color/track_value"
                                android:textSize="14sp"
                                android:tag="track_val"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </GridLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
