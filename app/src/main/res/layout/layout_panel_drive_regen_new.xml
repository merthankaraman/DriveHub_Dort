<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutDriveRegenPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="8dp"
    android:visibility="gone">

    <!-- Üst Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDriveRegenBack"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text="@string/back"
            android:textSize="44sp"
            app:cornerRadius="32dp"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/status_value"
            android:padding="0dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnDriveRegenBack"
            android:layout_marginStart="20dp"
            android:layout_centerVertical="true"
            android:text="@string/drive_regen_screen_title"
            android:textColor="@color/status_value"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClimatePanel"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/climate_settings"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            android:backgroundTint="@color/surface_variant"
            android:textColor="@color/status_value"
            android:paddingHorizontal="24dp"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <!-- GRUP 1: SÜRÜŞ MODLARI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="32dp"
                app:cardBackgroundColor="@color/surface_variant"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drive_mode"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:layout_gravity="center_horizontal"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEco"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="@string/drive_eco"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:cornerRadius="24dp"
                            android:backgroundTint="#1A7F37"
                            android:textColor="#FFFFFF"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNormal"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:text="@string/drive_normal"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:cornerRadius="24dp"
                            android:backgroundTint="#1F6FEB"
                            android:textColor="#FFFFFF"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSport"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="@string/drive_sport"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:cornerRadius="24dp"
                            android:backgroundTint="#9E3333"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSnow"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="@string/drive_snow"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:cornerRadius="24dp"
                            android:backgroundTint="#388BFD"
                            android:textColor="#FFFFFF"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDrive"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="@string/drive_custom"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:cornerRadius="24dp"
                            android:backgroundTint="#6B3FA0"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GRUP 2: REGEN AYARLARI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="32dp"
                app:cardBackgroundColor="@color/surface_variant"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/regen"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:layout_gravity="center_horizontal"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegenOff"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="@string/regen_off"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp"
                            android:backgroundTint="@color/panel_button_bg"
                            android:textColor="@color/status_value"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegenLow"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:text="@string/regen_low"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp"
                            android:backgroundTint="@color/panel_button_bg"
                            android:textColor="@color/status_value"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegenMedium"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="@string/regen_medium"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp"
                            android:backgroundTint="@color/panel_button_bg"
                            android:textColor="@color/status_value"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegenHigh"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:text="@string/regen_high"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp"
                            android:backgroundTint="@color/panel_button_bg"
                            android:textColor="@color/status_value"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegenAdaptive"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            android:text="@string/regen_adaptive"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp"
                            android:backgroundTint="@color/panel_button_bg"
                            android:textColor="@color/status_value"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegenOnePedal"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:text="@string/regen_one_pedal"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:cornerRadius="20dp"
                            android:backgroundTint="#FFA657"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRegenCurrent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
